<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MsfsUi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MSFS-UI-GENERATOR">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The product name is not translated.  -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="MSFS-UI-GENERATOR"
            AutomationProperties.AutomationId="AppTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <!--
                Light / dark theme, on the right of the title bar before the window buttons, as in Windows' own apps:
                a moon in the light theme, a sun in the dark one (the theme it switches to).
            -->
            <TitleBar.RightHeader>
                <Button
                    x:Name="ThemeButton"
                    Width="40"
                    Height="32"
                    Margin="0,0,4,0"
                    Padding="0"
                    AutomationProperties.AutomationId="ThemeToggle"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeButton_Click">
                    <FontIcon x:Name="ThemeIcon" FontSize="16" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AutomationProperties.AutomationId="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeItem"
                    x:Uid="NavHome"
                    AutomationProperties.AutomationId="NavHome"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavFeatures"
                    AutomationProperties.AutomationId="NavFeatures"
                    Tag="features">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavCompatibility"
                    AutomationProperties.AutomationId="NavCompatibility"
                    Tag="compatibility">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavLog"
                    AutomationProperties.AutomationId="NavLog"
                    Tag="log">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!--  At the bottom of the pane: the note on how the app works.  -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Uid="NavReadme"
                    AutomationProperties.AutomationId="NavReadme"
                    Tag="readme">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
