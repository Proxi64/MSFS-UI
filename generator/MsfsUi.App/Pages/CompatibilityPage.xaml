<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MsfsUi.App.Pages.CompatibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MsfsUi.App.ViewModels">
    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="CompatibilityTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="CompatibilityDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="CompatibilityRun"
                        AutomationProperties.AutomationId="CompatibilityRun"
                        Command="{x:Bind ViewModel.RunCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        x:Uid="CompatibilityRunning"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>

                <InfoBar
                    AutomationProperties.AutomationId="CompatibilitySummary"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.SummarySeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" />

                <!--  By origin (the sim's files, the running sim), then by group; a group with a failure is open.  -->
                <ItemsControl AutomationProperties.AutomationId="CompatibilitySections" ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckSection">
                            <StackPanel Margin="0,0,0,16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneTime}" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Summary, Mode=OneTime}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Groups, Mode=OneTime}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CheckGroup">
                                            <Expander
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                                IsExpanded="{x:Bind HasFailures, Mode=OneTime}">
                                                <Expander.Header>
                                                    <Grid Padding="0,10" ColumnSpacing="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneTime}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            Text="{x:Bind Summary, Mode=OneTime}" />
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{x:Bind Items, Mode=OneTime}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CheckItem">
                                                            <Grid Padding="0,4" ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon
                                                                    VerticalAlignment="Top"
                                                                    FontSize="14"
                                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                    Glyph="{x:Bind Glyph, Mode=OneTime}"
                                                                    Visibility="{x:Bind Ok, Mode=OneTime}" />
                                                                <FontIcon
                                                                    VerticalAlignment="Top"
                                                                    FontSize="14"
                                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                    Glyph="{x:Bind Glyph, Mode=OneTime}"
                                                                    Visibility="{x:Bind Failed, Mode=OneTime}" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock
                                                                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}"
                                                                        IsTextSelectionEnabled="True"
                                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                                        Text="{x:Bind Label, Mode=OneTime}"
                                                                        TextWrapping="Wrap" />
                                                                    <TextBlock
                                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                        IsTextSelectionEnabled="True"
                                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                                        Text="{x:Bind Detail, Mode=OneTime}"
                                                                        TextWrapping="Wrap"
                                                                        Visibility="{x:Bind HasDetail, Mode=OneTime}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
