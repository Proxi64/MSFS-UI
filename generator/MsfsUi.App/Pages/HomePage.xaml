<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MsfsUi.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <TextBlock
                    x:Uid="HomeTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <!--  Outcome of the last action. Closed bars are also collapsed: the page spacing would count them.  -->
                <InfoBar
                    AutomationProperties.AutomationId="HomeMessage"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}"
                    Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}" />

                <InfoBar
                    x:Uid="HomeSimUpdated"
                    AutomationProperties.AutomationId="HomeSimUpdated"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsSimUpdated, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.IsSimUpdated, Mode=OneWay}" />

                <InfoBar
                    x:Uid="HomeSettingsProblem"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasSettingsProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SettingsProblem, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.HasSettingsProblem, Mode=OneWay}" />

                <!--  The sim.  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="HomeSimHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />

                        <InfoBar
                            x:Uid="HomeSimNotFoundBar"
                            AutomationProperties.AutomationId="HomeLocateError"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasLocateError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.LocateError, Mode=OneWay}"
                            Severity="Error"
                            Visibility="{x:Bind ViewModel.HasLocateError, Mode=OneWay}" />

                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="HomeSimSourceLabel" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                AutomationProperties.AutomationId="HomeSimSource"
                                Style="{StaticResource FieldValueStyle}"
                                Text="{x:Bind ViewModel.SimSource, Mode=OneWay}" />

                            <TextBlock
                                x:Uid="HomeSimStateLabel"
                                Grid.Row="1"
                                Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="HomeSimState"
                                Style="{StaticResource FieldValueStyle}"
                                Text="{x:Bind ViewModel.SimState, Mode=OneWay}" />

                            <TextBlock
                                x:Uid="HomeFsBaseUiLabel"
                                Grid.Row="2"
                                Style="{StaticResource FieldLabelStyle}"
                                Visibility="{x:Bind ViewModel.IsSimFound, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="HomeFsBaseUi"
                                Style="{StaticResource FieldValueStyle}"
                                Text="{x:Bind ViewModel.FsBaseUi, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSimFound, Mode=OneWay}" />

                            <TextBlock
                                x:Uid="HomeCommunityLabel"
                                Grid.Row="3"
                                Style="{StaticResource FieldLabelStyle}"
                                Visibility="{x:Bind ViewModel.IsSimFound, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="HomeCommunity"
                                Style="{StaticResource FieldValueStyle}"
                                Text="{x:Bind ViewModel.Community, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSimFound, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="HomeChooseFolders"
                                AutomationProperties.AutomationId="HomeChooseFolders"
                                Command="{x:Bind ViewModel.ChooseFoldersCommand}" />
                            <Button
                                x:Uid="HomeUseDetectedFolders"
                                AutomationProperties.AutomationId="HomeUseDetectedFolders"
                                Command="{x:Bind ViewModel.UseDetectedFoldersCommand}"
                                Visibility="{x:Bind ViewModel.HasManualFolders, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  The package in Community.  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Uid="HomePackageHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />

                        <InfoBar
                            AutomationProperties.AutomationId="HomePackageStatus"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.PackageDetail, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.PackageSeverity, Mode=OneWay}"
                            Title="{x:Bind ViewModel.PackageHeadline, Mode=OneWay}">
                            <ItemsControl Margin="0,0,0,12" ItemsSource="{x:Bind ViewModel.Reasons, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </InfoBar>

                        <InfoBar
                            x:Uid="HomeConflicts"
                            AutomationProperties.AutomationId="HomeConflicts"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasConflicts, Mode=OneWay}"
                            Message="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="HomeInstall"
                                AutomationProperties.AutomationId="HomeInstall"
                                Command="{x:Bind ViewModel.InstallCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="HomeReload"
                                AutomationProperties.AutomationId="HomeReload"
                                Command="{x:Bind ViewModel.ReloadCommand}" />
                            <Button
                                x:Uid="HomeRemove"
                                AutomationProperties.AutomationId="HomeRemove"
                                Command="{x:Bind ViewModel.RemoveCommand}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                Margin="8,0,0,0"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
