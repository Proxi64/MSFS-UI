<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MsfsUi.App.Pages.ReadmePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <!--  A paragraph of the note.  -->
        <Style
            x:Key="ReadmeTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="ReadmeTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="ReadmeIntro" Style="{StaticResource ReadmeTextStyle}" />
                </StackPanel>

                <!--  The point the user wants clear first: the sim's files are never changed.  -->
                <InfoBar
                    x:Uid="ReadmeNoSimFile"
                    AutomationProperties.AutomationId="ReadmeNoSimFile"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Success" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="ReadmeHowHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="ReadmeHow1" Style="{StaticResource ReadmeTextStyle}" />
                        <TextBlock x:Uid="ReadmeHow2" Style="{StaticResource ReadmeTextStyle}" />
                        <TextBlock x:Uid="ReadmeHow3" Style="{StaticResource ReadmeTextStyle}" />
                        <TextBlock x:Uid="ReadmeHow4" Style="{StaticResource ReadmeTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="ReadmePagesHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="ReadmePageHome" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageHomeText"
                                Grid.Column="1"
                                Style="{StaticResource ReadmeTextStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageFeatures"
                                Grid.Row="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageFeaturesText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ReadmeTextStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageCompatibility"
                                Grid.Row="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageCompatibilityText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource ReadmeTextStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageLog"
                                Grid.Row="3"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ReadmePageLogText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource ReadmeTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="ReadmeUpdateHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="ReadmeUpdateText" Style="{StaticResource ReadmeTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="ReadmeFilesHeader"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Uid="ReadmeFilesText" Style="{StaticResource ReadmeTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    AutomationProperties.AutomationId="ReadmeVersion"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind VersionText, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
