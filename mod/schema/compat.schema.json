{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msfs-ui.local/schema/compat.schema.json",
  "title": "MSFS-UI compatibility manifest",
  "description": "What the menu mod relies on in the sim (see Contracts in docs/development.md). Read by the app's compatibility check (MsfsUi.Core CompatibilityChecker). Every name must be precise enough not to be found elsewhere in the sim's files.",
  "type": "object",
  "required": [
    "schemaVersion",
    "exports",
    "screens",
    "components",
    "anchors",
    "componentPatterns",
    "symbols",
    "files",
    "colorVariables",
    "translations",
    "liveChecks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "exports": {
      "description": "Readable exports by module under html_ui/Global (never the minified names of lib.js).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module",
          "names"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+\\.js$"
          },
          "names": {
            "$ref": "#/$defs/names"
          }
        }
      }
    },
    "screens": {
      "description": "Screens the mod hooks: component GUID and manipulator class.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "guid",
          "className"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "guid": {
            "type": "string",
            "pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"
          },
          "className": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        }
      }
    },
    "components": {
      "description": "The sim's components that the mod creates itself (cookedcomps/{GUID}), with what the mod uses of them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "guid",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "guid": {
            "type": "string",
            "pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "attributes": {
            "$ref": "#/$defs/names"
          },
          "states": {
            "$ref": "#/$defs/names"
          },
          "values": {
            "$ref": "#/$defs/names"
          },
          "children": {
            "description": "Names of elements inside the component that the mod's CSS adjusts, looked for in the component's own markup.",
            "$ref": "#/$defs/names"
          }
        }
      }
    },
    "options": {
      "description": "Options of the sim the mod uses (General options: their section and their id, which carries a GUID). The profile save (mod/src/sim/profile-save.ts) re-validates one with its current value, so that the sim writes its storage to the disk.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "section",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "pattern": "^MENU_OPTIONS_[A-Z_]+$"
          },
          "id": {
            "type": "string",
            "pattern": "^OptionsGeneralItemGUID_\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}$"
          }
        }
      }
    },
    "anchors": {
      "description": "Element names (name=\"…\") the mod looks up in the sim's components.",
      "$ref": "#/$defs/names"
    },
    "componentPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "label",
          "component",
          "patterns",
          "failure"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "$ref": "#/$defs/text"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "component": {
            "$ref": "#/$defs/text"
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "failure": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "symbols": {
      "description": "Data-model paths and engine events, looked up in the sim's scripts.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "names"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "$ref": "#/$defs/text"
          },
          "names": {
            "$ref": "#/$defs/names"
          }
        }
      }
    },
    "files": {
      "description": "Sim files the mod loads, relative to the fs-base-ui package (html_ui/… or components/…).",
      "$ref": "#/$defs/names"
    },
    "colorVariables": {
      "description": "CSS variables of the sim read by the mod (colours, font sizes, screen height, background opacity), checked live on html / body.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^--[A-Za-z0-9-]+$"
      }
    },
    "translations": {
      "description": "Translation keys of the sim reused by the mod.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TT:"
      }
    },
    "liveChecks": {
      "description": "Checks run in the mainUi page while the sim runs.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "label",
          "run"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "$ref": "#/$defs/text"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "run": {
            "description": "ES2017 function source: (ctx) => ({ ok, detail }) or a promise of it; ctx = { store, engineUi, utils, flight, aircraft }.",
            "$ref": "#/$defs/text"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
